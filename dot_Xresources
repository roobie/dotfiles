! HiDPI scaling for UHD eDP-1 panel — 2x of standard 96 DPI.
! Merged automatically by /etc/X11/Xsession.d/30x11-common_xresources.
!Xft.dpi:        192
!Xcursor.size:   48

! Reasonable subpixel rendering for LCD panels.
Xft.antialias:  true
Xft.hinting:    true
Xft.hintstyle:  hintslight
Xft.rgba:       rgb
Xft.lcdfilter:  lcddefault
